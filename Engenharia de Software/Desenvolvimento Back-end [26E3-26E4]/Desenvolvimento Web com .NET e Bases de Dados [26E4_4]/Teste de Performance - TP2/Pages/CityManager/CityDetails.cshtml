@page "{cityName}"
@model Teste_de_Performance___TP2.Pages.CityManager.CityDetailsModel

@{
    ViewData["Title"] = "Detalhes da Cidade";
}

<h1>Detalhes da Cidade</h1>

@if (Model.CityNotFound)
{
    <div class="mt-3">
        Cidade não encontrada.
    </div>
}
else
{
    <p>
        Você está vendo detalhes de: <strong>@Model.CityName</strong>
    </p>
}

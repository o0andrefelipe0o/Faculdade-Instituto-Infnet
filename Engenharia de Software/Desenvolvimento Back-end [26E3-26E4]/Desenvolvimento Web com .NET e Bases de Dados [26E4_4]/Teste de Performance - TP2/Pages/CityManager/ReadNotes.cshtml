@page
@model Teste_de_Performance___TP2.Pages.CityManager.ReadNotesModel

@{
    ViewData["Title"] = "Notas Salvas";
}

@if (Model.FileContent != null)
{
    <h2>@Model.SelectedFileName</h2>

    <pre class="border rounded p-3">@Model.FileContent</pre>
    
    <a asp-page="/CityManager/ReadNotes" class="btn btn-outline-primary">
        Voltar
    </a>
}
else if (Model.Files.Count == 0)
{
    <h1>Notas Salvas</h1>
    <p>Nenhuma nota encontrada.</p>
}
else
{
    <h1>Notas Salvas</h1>
    <ul class="list-group">
        @foreach (var file in Model.Files)
        {
            <li class="list-group-item">
                <a asp-page-handler="View"
                   asp-route-fileName="@file">
                    @file
                </a>
            </li>
        }
    </ul>
}